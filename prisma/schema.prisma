generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  DRAFT
  SUBMITTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  INCOMPLETE
  ABSENT
  NON_WORKING
  NEEDS_REVIEW
}

enum ImportEntity {
  TERRITORY
  CENTER
  PRODUCT
}

enum ContractDurationUnit {
  DAYS
  MONTHS
  YEARS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// Superseded by the ActivityTypeDef lookup table below (Story A: 11
// client-defined activity types, admin-extensible, with per-type
// follow-up-interval config) — kept here only as the historical name of
// what Activity.type used to be, for anyone grepping the migration history.
// enum ActivityType { CAMPAIGN EVENT OTHER }

// Drives which fields a screen renders for a given ActivityTypeDef:
// STANDARD_EVENT covers RTM, CPN, CPS, CME, Nurse Conference, Bonjour,
// Necessity-Driven, Matinee Scientifique, La Garde (one shared-plan +
// per-delegate-execution model, see Activity/ActivityAssignment below) plus
// the legacy CAMPAIGN/EVENT/OTHER values. PRESCRIPTION_TRACKING and
// EMBALLAGE are structurally different (target-accumulation and
// repeatable-collection respectively) and are modeled as their own
// standalone tables entirely, not as Activity rows.
enum ActivityCategory {
  STANDARD_EVENT
  PRESCRIPTION_TRACKING
  EMBALLAGE
}

// Per-assignment, not per-activity: the same activity can be assigned to
// several users at once, each tracked independently (see ActivityAssignment).
enum ActivityAssignmentStatus {
  PLANNED
  DONE
  CANCELLED
}

// MISSED is deliberately not a stored value — it's computed at read time
// (PENDING + the route's date has passed) in route-service.ts, the same
// "computed, not stored" choice as attendance's ABSENT/NON_WORKING. A
// RouteItem never needs to be written to just because nobody acted on it.
enum RouteItemStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum FollowUpStatus {
  PENDING
  DONE
}

// --- Identity ---

model Role {
  id               String           @id @default(cuid())
  name             String           @unique
  description      String?
  // Seed-time constant, no Role management UI — default GPS requirement for
  // attendance (check-in and check-out), overridable per user via
  // User.requiresLocation.
  requiresLocation Boolean          @default(false)
  users            User[]
  permissions      RolePermission[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

// Explicit join model (rather than an implicit many-to-many) so the grant
// itself carries an audit trail of who assigned which permission to which
// role and when.
model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String @id @default(cuid())
  employeeCode String @unique
  name         String
  email        String @unique
  passwordHash String
  status       Status @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // null = inherit Role.requiresLocation; true/false explicitly overrides
  // the role default for this user only.
  requiresLocation Boolean?

  managerId     String?
  manager       User?   @relation("UserManager", fields: [managerId], references: [id])
  directReports User[]  @relation("UserManager")

  // The Territory a user is scoped to — a Territory already represents
  // whatever depth (Province alone, down to a full Quartier path) an admin
  // picked, so one FK is enough; there's no need for four independent
  // level fields the way there was before Territory existed as its own
  // entity.
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id])

  // Contract tracking. All three are set together or not at all (enforced
  // in the Zod schema, not here) — contractExpiryDate is never accepted
  // from the client; it's computed server-side from the other two whenever
  // either changes, same reasoning as order totals never being trusted from
  // the browser.
  contractStartDate     DateTime?             @db.Date
  contractDurationValue Int?
  contractDurationUnit  ContractDurationUnit?
  contractExpiryDate    DateTime?             @db.Date

  visits                    Visit[]
  orders                    Order[]
  attendances               Attendance[]
  targets                   Target[]
  territoryAssignments      UserTerritoryAssignment[]
  leaves                    Leave[]
  ownedAttendanceRules      AttendanceRule[]          @relation("AttendanceRuleOwner")
  targetedAttendanceRules   AttendanceRule[]          @relation("AttendanceRuleTarget")
  routeAssignments          RouteAssignment[]
  activityAssignments       ActivityAssignment[]
  ownedFollowUps            FollowUp[]                @relation("FollowUpOwner")
  followUpReassignedFrom    FollowUpReassignment[]    @relation("FollowUpReassignPrevOwner")
  followUpReassignedTo      FollowUpReassignment[]    @relation("FollowUpReassignNewOwner")
  followUpReassignmentsMade FollowUpReassignment[]    @relation("FollowUpReassignActor")
  emballageCollections      EmballageCollection[]
  emballageCorrectionsMade  EmballageCorrection[]
  emballageReportsFinalized EmballageReportRun[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([territoryId, status])
  @@index([roleId, status])
  @@index([managerId])
  @@map("users")
}

// --- Geography: a fixed 4-level administrative hierarchy
// (Province > Ville > Commune > Quartier), matching how the client's own
// location data is structured. These are pure geography lookups — no code
// of their own. The business/assignment entity built on top of them is
// Territory, below: a Territory is a specific selected path through this
// hierarchy (Province alone, or down through Ville/Commune/Quartier), and
// it alone carries the unique code. ---

model Province {
  id     String @id @default(cuid())
  name   String @unique
  status Status @default(ACTIVE)

  villes      Ville[]
  territories Territory[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("provinces")
}

model Ville {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])

  communes    Commune[]
  territories Territory[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@map("villes")
}

model Commune {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  villeId String
  ville   Ville  @relation(fields: [villeId], references: [id])

  quartiers   Quartier[]
  territories Territory[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([villeId, name])
  @@map("communes")
}

model Quartier {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])

  territories Territory[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([communeId, name])
  @@map("quartiers")
}

// The business/assignment entity: one specific selected path through the
// geography hierarchy above — Province alone, Province→Ville, →Commune, or
// →Quartier. `code` is backend-generated (sequential, e.g. TER-00001),
// never entered through the UI. `pathKey` is an application-maintained
// dedup key (province:ville:commune:quartier ids, "-" for an absent
// level) — a plain composite @@unique on the four nullable FKs can't do
// this reliably, since Postgres treats NULL as never equal to NULL, so two
// Territories that both stop at Province (villeId/communeId/quartierId all
// null) would never collide on a native unique index the way they need to.
model Territory {
  id     String @id @default(cuid())
  code   String @unique
  status Status @default(ACTIVE)

  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])

  villeId String?
  ville   Ville?  @relation(fields: [villeId], references: [id])

  communeId String?
  commune   Commune? @relation(fields: [communeId], references: [id])

  quartierId String?
  quartier   Quartier? @relation(fields: [quartierId], references: [id])

  pathKey String @unique

  users                User[]
  centers              Center[]
  targets              Target[]
  territoryAssignments UserTerritoryAssignment[]
  holidays             Holiday[]
  workingDays          TerritoryWorkingDay[]
  attendanceRules      AttendanceRule[]
  activities           Activity[]
  contacts             Contact[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([provinceId, status])
  @@index([villeId])
  @@index([communeId])
  @@map("territories")
}

// One row per (user, Territory) assignment — the set of Territories a
// delegate is allowed to work in (S2-04). Distinct from User's own
// `territoryId` above: that stays a default/display value, but any
// future work-scoping logic (e.g. restricting which centers a delegate can
// select) must read from this table instead.
//
// A single `territoryId` (not four independent level FKs) is enough now
// that each distinct hierarchy path is already its own Territory row — a
// Province-level assignment and a Quartier-level assignment underneath it
// are simply two different Territory ids, both freely assignable to the
// same user (harmless overlap, deliberately not blocked — see the project
// decision log for S2-04).
model UserTerritoryAssignment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([userId, territoryId])
  @@map("user_territory_assignments")
}

// --- Master data ---

model CenterType {
  id   String @id @default(cuid())
  code String @unique
  name String

  centers Center[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("center_types")
}

model Center {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  // The name of the on-site contact in charge — distinct from `mobileNo`,
  // which is the Center's own free-text mobile number and doesn't identify
  // who it belongs to.
  responsiblePerson String?
  mobileNo          String?
  address           String?
  latitude          Decimal? @db.Decimal(9, 6)
  longitude         Decimal? @db.Decimal(9, 6)
  status            Status   @default(ACTIVE)

  typeId String
  type   CenterType @relation(fields: [typeId], references: [id])

  // Same reasoning as User.territoryId — a Territory already represents
  // whatever depth this center is known to, so one FK replaces what used
  // to be four independent level fields.
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id])

  visits               Visit[]
  orders               Order[]
  routeItems           RouteItem[]
  activities           Activity[]
  contacts             ContactCenter[]
  emballageCollections EmballageCollection[]

  // Set only for HOSPITAL-type centers. Kept as an optional one-to-one
  // extension rather than fields on Center itself so other center types
  // carry no unused columns.
  hospital Hospital?
  pharmacy Pharmacy?

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([territoryId, status])
  @@index([typeId, status])
  @@map("centers")
}

// One-to-one extension of Center for the HOSPITAL type.
model Hospital {
  id String @id @default(cuid())

  centerId String @unique
  center   Center @relation(fields: [centerId], references: [id])

  hospitalCategory String?

  visits Visit[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("hospitals")
}

// One-to-one extension of Center for the PHARMACY type.
model Pharmacy {
  id String @id @default(cuid())

  centerId String @unique
  center   Center @relation(fields: [centerId], references: [id])

  // The sales/distributor channel currently managing this account (e.g.
  // GENCARE, HOSPICARE, NOVACARE) -- not a geography signal, just which
  // distributor brand serves it. Free text, same treatment as
  // Hospital.hospitalCategory, since the source data isn't a fixed taxonomy.
  currentDivision String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("pharmacies")
}

// Lookup table, same pattern as CenterType — the price list has no
// classification column at all, so this stays a short seeded list (or
// left unset on a Product) rather than a fixed enum, until the client
// confirms an actual taxonomy.
model ProductCategory {
  id   String @id @default(cuid())
  code String @unique
  name String

  products Product[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("product_categories")
}

// Base currency is always USD (D3: confirmed with the client — see
// ExchangeRate below for the CDF conversion, which is display-only and
// never stored here). The source price list carries two prices per
// product — grossPrice and a netPrice already discounted — and both are
// stored as-is rather than netPrice being derived from a percentage,
// since the discount isn't confirmed to be a fixed, permanent rule.
model Product {
  id                String  @id @default(cuid())
  code              String  @unique
  name              String
  grossPrice        Decimal @db.Decimal(12, 2)
  netPrice          Decimal @db.Decimal(12, 2)
  // Units per carton for bulk ordering/logistics — not used in pricing math.
  quantityPerCarton Int     @default(1)
  status            Status  @default(ACTIVE)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  orderItems               OrderItem[]
  targets                  Target[]
  priceHistory             ProductPriceHistory[]
  activityProducts         ActivityProduct[]
  assignmentProductResults AssignmentProductResult[]
  emballageCollections     EmballageCollection[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([categoryId, status])
  @@map("products")
}

// One row per price change (S2-03: "a later price change cannot alter a
// submitted order") — appended on every create and on every update that
// changes either price, never edited or deleted, so a past price can
// always be reconstructed independently of what the Product row now says.
model ProductPriceHistory {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  grossPrice Decimal @db.Decimal(12, 2)
  netPrice   Decimal @db.Decimal(12, 2)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("product_price_history")
}

// USD → CDF conversion rate, set manually by an admin (the client's rate
// always runs a bit above the central bank's, and is only ever updated by
// hand — see the D3 discussion). Append-only: changing the rate inserts a
// new row rather than overwriting the last one, so a value already
// snapshotted elsewhere (e.g. onto an Order, in a later sprint) is never
// affected by a later change, and "the rate on a given date" stays
// reconstructable. "Current" is always the row with the latest
// effectiveFrom.
model ExchangeRate {
  id            String   @id @default(cuid())
  rate          Decimal  @db.Decimal(12, 4)
  effectiveFrom DateTime @default(now())

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("exchange_rates")
}

// --- Visits ---

model Visit {
  id String @id @default(cuid())

  delegateId String
  delegate   User   @relation(fields: [delegateId], references: [id])

  centerId String
  center   Center @relation(fields: [centerId], references: [id])

  // Which Hospital the visit happened at, when relevant. Optional: a visit
  // straight to a Hospital or to a Chemist/Pharmacy center has no separate
  // hospital to record.
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  startAt  DateTime
  endAt    DateTime?
  startLat Decimal   @db.Decimal(9, 6)
  startLng Decimal   @db.Decimal(9, 6)
  endLat   Decimal?  @db.Decimal(9, 6)
  endLng   Decimal?  @db.Decimal(9, 6)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("visits")
}

// --- Orders ---

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(DRAFT)

  delegateId String
  delegate   User   @relation(fields: [delegateId], references: [id])

  centerId String
  center   Center @relation(fields: [centerId], references: [id])

  items OrderItem[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

// --- Attendance ---

// Day-level row: one per user per calendar day, holding the derived status
// (S3-04) and owning any number of check-in/check-out cycles for that day.
// Created lazily on a user's first check-in of the day.
model Attendance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  date   DateTime
  status AttendanceStatus @default(NEEDS_REVIEW)

  sessions AttendanceSession[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("attendances")
}

// One check-in/check-out cycle. A day can hold several — a delegate may
// check in and out multiple times on the same working day. checkOutAt null
// means the session is still open; the partial unique index in the
// migration (one open session per Attendance) enforces at the database
// level that a day never has more than one cycle running at once, the same
// way S4-01 constrains one active visit per delegate.
model AttendanceSession {
  id String @id @default(cuid())

  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id])

  checkInAt       DateTime
  checkInLat      Decimal?  @db.Decimal(9, 6)
  checkInLng      Decimal?  @db.Decimal(9, 6)
  // Device's own clock at check-in — reference only, never authoritative;
  // checkInAt (server time) is the business-event timestamp.
  checkInDeviceAt DateTime?
  // The GPS fix's own confidence radius in meters, not a distance to
  // anything else — the quality gate used at check-in time.
  checkInAccuracy Decimal?  @db.Decimal(10, 2)

  checkOutAt       DateTime?
  checkOutLat      Decimal?  @db.Decimal(9, 6)
  checkOutLng      Decimal?  @db.Decimal(9, 6)
  // Device's own clock at check-out — reference only, never authoritative;
  // checkOutAt (server time) is the business-event timestamp.
  checkOutDeviceAt DateTime?
  // The GPS fix's own confidence radius in meters — same quality gate
  // (MAX_ACCEPTABLE_ACCURACY_METERS) applied at check-out as at check-in.
  checkOutAccuracy Decimal?  @db.Decimal(10, 2)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([attendanceId])
  @@map("attendance_sessions")
}

// S3-04: configurable late/incomplete thresholds, admin/manager/supervisor
// editable via UI (not a hardcoded constant — client explicitly wants this
// changeable without a deploy). Insert-only / versioned: a change always
// creates a new row, never updates an existing one. This is what lets
// re-running status derivation for a past business date stay stable even
// after a rule is edited later — resolution filters candidates to
// `createdAt <= businessDate` and takes the newest, so a row created after
// the date being evaluated simply can never apply to it. updatedAt/updatedBy
// are carried for convention consistency only; they're never meaningfully
// used since rows are never edited in place.
//
// Exactly one of territoryId / ownerId / targetUserId is set per row (all
// three null = the global/admin default):
//   - territoryId: applies to every delegate assigned to that territory.
//   - ownerId: "team" scope — applies to everyone in the owner's downstream
//     reporting chain (see getUpstreamManagerIds/getDownstreamUserIds in
//     scope.ts).
//   - targetUserId: "individual" scope — applies to exactly one delegate.
// Resolution (attendance-rule-service.ts) gathers every candidate that could
// apply to a given delegate across all three scopes plus the global
// default, keeps only those valid as of the business date, and takes the
// single most-recently-created one — recency wins regardless of scope type
// or which role (admin/manager/supervisor) created it.
model AttendanceRule {
  id String @id @default(cuid())

  // Minutes since midnight a delegate is expected to check in by (e.g. 540
  // = 09:00) — there's no shift-start concept anywhere else in the schema,
  // so this rule is also where that expectation itself is configured, not
  // just the grace period around it.
  expectedStartMinutes Int
  // Grace period after expectedStartMinutes before a check-in counts as
  // LATE rather than PRESENT.
  lateGraceMinutes     Int
  // Total worked minutes (summed across the day's sessions) below which a
  // day counts as INCOMPLETE even if every session has a check-out. A day
  // with a check-in and no check-out at all is always INCOMPLETE regardless
  // of this value.
  minimumWorkedMinutes Int

  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id])

  ownerId String?
  owner   User?   @relation("AttendanceRuleOwner", fields: [ownerId], references: [id])

  targetUserId String?
  targetUser   User?   @relation("AttendanceRuleTarget", fields: [targetUserId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([territoryId])
  @@index([ownerId])
  @@index([targetUserId])
  @@map("attendance_rules")
}

// --- Targets ---

model Target {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  quantity    Decimal  @db.Decimal(12, 2)
  value       Decimal  @db.Decimal(14, 2)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("targets")
}

// --- Bulk import (S2-05) ---

// One row per completed import run — an audit record distinct from each
// imported row's own createdBy/updatedBy, answering "who ran this import,
// on what file, with what outcome" without reconstructing it after the
// fact from individual center/product/territory rows. Write-once: nothing
// updates one of these after it's created, but it still carries the
// standard audit columns per convention (Section 4 of the execution plan).
model ImportBatch {
  id            String       @id @default(cuid())
  entity        ImportEntity
  fileName      String
  totalRows     Int
  createdCount  Int
  updatedCount  Int
  rejectedCount Int

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("import_batches")
}

// --- Working calendar (S3-01) ---

// Lookup table, same pattern as CenterType/ProductCategory — no status
// field, since deactivating a leave type mid-use isn't a requirement here.
model LeaveType {
  id   String @id @default(cuid())
  code String @unique
  name String

  leaves Leave[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("leave_types")
}

// Admin-maintained calendar fact, distinct from Leave (which is a
// per-employee request with an approval workflow). A single date is
// startDate == endDate; territoryId null means the holiday applies to every
// territory. `isWorkingDay` treats every date within [startDate, endDate] on
// an ACTIVE row as non-working.
model Holiday {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  status    Status   @default(ACTIVE)

  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([territoryId, startDate])
  @@map("holidays")
}

// One row per employee leave request. Starts PENDING; the only permitted
// transitions are PENDING -> APPROVED and PENDING -> REJECTED (enforced in
// leave-service.ts, not here) — there is no reopen/correction workflow for
// this story. decidedBy/decidedAt record who made that decision and when,
// distinct from the generic updatedBy/updatedAt, which just say who last
// touched the row. Authorization for who may decide a given request is
// resolved via the existing reporting-hierarchy scope helper
// (src/server/scope.ts), not a separate approver relation on this model.
model Leave {
  id        String      @id @default(cuid())
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  reason    String?
  status    LeaveStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  decidedBy      String?
  decidedAt      DateTime?
  // The approver's own remark on their decision — optional on both approve
  // and reject, kept separate from the requester's own `reason` above.
  decisionRemark String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("leaves")
}

// One row per (territory, day-of-week), 7 per territory. dayOfWeek follows
// JS Date#getUTCDay() (0 = Sunday .. 6 = Saturday) so working-day-service.ts
// needs no translation layer. Auto-created (Mon-Sat working, Sunday off) by
// territory-service.ts whenever a Territory is created — see D4 in the
// execution plan, still formally open with the client; this is an editable
// placeholder, never a hard-coded assumption in attendance logic.
model TerritoryWorkingDay {
  id        String  @id @default(cuid())
  dayOfWeek Int
  isWorking Boolean

  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([territoryId, dayOfWeek])
  @@map("territory_working_days")
}

// --- Visit planning (S3-06) ---

// A route is an ordered list of centers (RouteItem), each optionally with
// the contacts to see there. Items are added before the route's startDate
// and locked once it begins (see isRouteEditable); visit *execution* is
// tracked per item/contact status, not per day.
//
// A route's stop list (items) is shared plan content — who it's assigned to
// is tracked entirely through RouteAssignment, not on this row. A route can
// have zero, one or several concurrently ACTIVE assignments (e.g. the same
// route covered by two delegates on overlapping dates); each assignee's own
// progress through the stops is tracked independently via
// RouteItemExecution / RouteItemContactExecution, keyed to their specific
// RouteAssignment.
//
// `code` (RT-00001) is the human-readable identifier, from route_code_seq
// (created in the migration), immutable once written.
model Route {
  id   String @id @default(cuid())
  code String @unique

  items       RouteItem[]
  assignments RouteAssignment[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("routes")
}

enum RouteAssignmentStatus {
  ACTIVE
  CANCELLED
}

// One assignee's hold on a route for a date range — the live source of
// truth for "who is covering this route," not just history. Several rows
// for the same routeId can be ACTIVE at once (concurrent assignment).
// Reassigning cancels this row and creates a new one for the new assignee —
// same cancel-and-recreate pattern as ActivityAssignment reassignment — so
// every past holder and range stays on the record rather than being
// overwritten. Cancelling just flips status to CANCELLED in place.
model RouteAssignment {
  id String @id @default(cuid())

  routeId String
  route   Route  @relation(fields: [routeId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status RouteAssignmentStatus @default(ACTIVE)

  startDate DateTime?
  endDate   DateTime?

  itemExecutions    RouteItemExecution[]
  contactExecutions RouteItemContactExecution[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([routeId, status])
  @@index([userId, status])
  @@index([userId, startDate])
  @@map("route_assignments")
}

// `sequence` is the delegate's chosen visit order for the day — assigned
// on add (next available slot) and rewritten wholesale on reorder, never
// treated as a stable identity of its own. This row is shared plan content
// (the stop list itself); per-assignee completion lives in
// RouteItemExecution, not here.
model RouteItem {
  id String @id @default(cuid())

  routeId String
  route   Route  @relation(fields: [routeId], references: [id])

  centerId String
  center   Center @relation(fields: [centerId], references: [id])

  contacts   RouteItemContact[]
  executions RouteItemExecution[]

  sequence Int

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  // Enforces "no duplicate center on the same route/date" at the database
  // level — the service layer gives a friendlier error before ever hitting
  // this constraint, but the constraint is the actual backstop.
  @@unique([routeId, centerId])
  @@index([routeId])
  @@map("route_items")
}

// A Contact selected under one specific Center on a route (a RouteItem).
// The Contact<->Center link itself still lives only in ContactCenter — this
// row records "who the visitor is meant to see at this stop" and is
// validated against ContactCenter on every write, never trusted from the
// client. Shared plan content, same as RouteItem — per-assignee completion
// lives in RouteItemContactExecution, not here.
model RouteItemContact {
  id String @id @default(cuid())

  routeItemId String
  routeItem   RouteItem @relation(fields: [routeItemId], references: [id])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  executions RouteItemContactExecution[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([routeItemId, contactId])
  @@index([contactId])
  @@map("route_item_contacts")
}

// One assignee's completion state for one stop. `status` is stored per
// assignment (MISSED is computed at read time, like the old RouteItem.status
// was); for a Center that has Contacts, RouteItemExecution.status is
// derived from RouteItemContactExecution the same way RouteItem.status used
// to derive from RouteItemContact (see deriveCenterStatus in
// route-service.ts). Rows are never deleted once COMPLETED/CANCELLED, even
// if the underlying plan content changes later — that is history.
model RouteItemExecution {
  id String @id @default(cuid())

  routeItemId String
  routeItem   RouteItem @relation(fields: [routeItemId], references: [id])

  routeAssignmentId String
  routeAssignment   RouteAssignment @relation(fields: [routeAssignmentId], references: [id])

  status RouteItemStatus @default(PENDING)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([routeItemId, routeAssignmentId])
  @@index([routeAssignmentId])
  @@map("route_item_executions")
}

// One assignee's completion state for one contact within a stop — the
// per-assignment counterpart to RouteItemContact, same relationship
// RouteItemExecution has to RouteItem.
model RouteItemContactExecution {
  id String @id @default(cuid())

  routeItemContactId String
  routeItemContact   RouteItemContact @relation(fields: [routeItemContactId], references: [id])

  routeAssignmentId String
  routeAssignment   RouteAssignment @relation(fields: [routeAssignmentId], references: [id])

  status RouteItemStatus @default(PENDING)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([routeItemContactId, routeAssignmentId])
  @@index([routeAssignmentId])
  @@map("route_item_contact_executions")
}

// --- Marketing activity planning and follow-ups (S3-07, extended by the
// 11-type marketing activity taxonomy described in the project's activity
// requirements) ---

// Admin-maintained, not a hardcoded enum — the client's 11 activity types
// (plus the 3 legacy CAMPAIGN/EVENT/OTHER values, preserved as their own
// rows so existing Activity data needs no reclassification) are expected to
// grow over time, and each carries its own default auto-follow-up timing.
//
// defaultFollowUpInitialOffsetDays: days from activity completion to the
// first auto-created follow-up (RTM: 2, CME/Nurse Conference: 3,
// Necessity-Driven: 30). defaultFollowUpRecurrenceIntervalDays: gap between
// subsequent links in the chain (CME/Nurse Conference and Necessity-Driven:
// 30; null for types with no chain, e.g. RTM). defaultFollowUpSeriesDurationDays:
// hard cutoff window from completion (90 for CME/Nurse Conference and
// Necessity-Driven). CPS, Matinee Scientifique and La Garde ship with all
// three null — manual follow-up only until an admin configures them. The
// actual chain-generation logic that reads these lives in Story B
// (follow-up engine); this table only carries the configuration.
model ActivityTypeDef {
  id       String           @id @default(cuid())
  code     String           @unique
  name     String
  category ActivityCategory
  status   Status           @default(ACTIVE)

  defaultFollowUpInitialOffsetDays      Int?
  defaultFollowUpRecurrenceIntervalDays Int?
  defaultFollowUpSeriesDurationDays     Int?
  // true only for RTM: on completion, create one FollowUp per present
  // participant (fan-out), instead of the single assignment-level chain
  // every other configured type uses. A separate explicit flag rather than
  // inferring "per-participant" from recurrenceIntervalDays being null —
  // those are two different axes (who the follow-up is about vs. whether it
  // repeats) and collapsing them would misclassify a future type that wants
  // either a non-repeating assignment-level follow-up or a repeating
  // per-participant one.
  defaultFollowUpPerParticipant         Boolean @default(false)

  activities Activity[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("activity_type_defs")
}

// Necessity-Driven's requirement dropdown — a lookup table (same pattern as
// CenterType/ProductCategory), not a closed enum, since the client's
// starting list (hospital materials, personal-use materials, special gifts,
// hospital painting, pharmacy painting, other) is explicitly extensible.
model RequirementCategoryDef {
  id     String @id @default(cuid())
  code   String @unique
  name   String
  status Status @default(ACTIVE)

  activities Activity[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("requirement_category_defs")
}

// Exactly one of centerId/territoryId is set, enforced at the Zod boundary
// (src/lib/schemas/activity.ts), not at this level — Prisma has no native
// "exactly one of" column constraint. The activity itself carries no
// assignee or status: who's doing it, and how that's going, is tracked per
// assignment below, since the same activity can be assigned to several users
// at once (unlike Route, which has exactly one holder at a time).
//
// Fields on this model are the *shared, planned* facts about the
// activity/meeting — the same for every delegate assigned to it (what was
// selected, who was invited, where it is, what it costs to run). Facts that
// genuinely differ per delegate's own execution (who was actually present,
// what they personally achieved) live on ActivityAssignment and its child
// tables below instead — see AssignmentParticipantResult / AssignmentProductResult.
model Activity {
  id    String  @id @default(cuid())
  name  String
  notes String?

  typeId String
  type   ActivityTypeDef @relation(fields: [typeId], references: [id])

  centerId String?
  center   Center? @relation(fields: [centerId], references: [id])

  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id])

  // Free-text venue detail, additive to (not a replacement for) center/
  // territory — covers RTM/CME-style meetings held somewhere not registered
  // as a Center.
  location       String?
  // Sub-location within a hospital Center (Matinee Scientifique's
  // "centre/department", La Garde's "hospital/Urgence department").
  departmentName String?

  // CME / Nurse Conference's selected speaker doctor. Shared meeting
  // information, so it lives here rather than per-assignment.
  speakerContactId String?
  speaker          Contact? @relation("ActivitySpeaker", fields: [speakerContactId], references: [id])

  // Necessity-Driven: the client's creation-form spec lists this as the
  // *only* required field at creation — the manager decides the kind of
  // need upfront. Contrast with requirementValue/supportProvidedDescription/
  // recipientContactId on ActivityAssignment below, which stay execution-
  // time (the delegate records what was actually given when they fulfill
  // it).
  requirementCategoryId String?
  requirementCategory   RequirementCategoryDef? @relation(fields: [requirementCategoryId], references: [id])

  // Expected counts set at creation time — the planning figure, distinct
  // from ActivityAssignment.actualParticipants (the delegate's own
  // execution-time count). Two separate fields, not one generic count,
  // mirroring the client's own wording: CPN/CPS/Bonjour say "prescribers",
  // Matinee Scientifique/La Garde say "participants".
  prescriberCount      Int? // CPN / CPS / Bonjour
  expectedParticipants Int? // Matinee Scientifique / La Garde

  // Shared/organizer-level event cost (one breakfast arranged, one
  // transport bill for the whole RTM) — distinct from any delegate's own
  // reported expense on ActivityAssignment below; the two are never summed
  // automatically.
  foodExpense      Decimal? @db.Decimal(12, 2)
  transportExpense Decimal? @db.Decimal(12, 2)

  products     ActivityProduct[]
  participants ActivityParticipant[]
  assignments  ActivityAssignment[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([typeId])
  @@index([requirementCategoryId])
  @@map("activities")
}

// Shared/planned product list for an activity (RTM, CME, Bonjour, Matinee
// Scientifique, La Garde, etc. all select multiple products up front).
// `availability` is a shared fact about the product at the venue (La
// Garde's "product availability") — not delegate-specific, unlike the
// prescriptions/business/samples outcomes, which live on
// AssignmentProductResult instead.
model ActivityProduct {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  availability String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([activityId, productId])
  @@map("activity_products")
}

// Shared/planned "invited" list for an activity (RTM's invited doctors,
// CME's participating HCPs). Who actually showed up, and each assignee's
// own notes on them, is recorded per-assignee on AssignmentParticipantResult
// instead — this table only records the plan, not the outcome.
model ActivityParticipant {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])
  contactId  String
  contact    Contact  @relation("ActivityParticipantContact", fields: [contactId], references: [id])

  invited Boolean @default(true)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([activityId, contactId])
  @@map("activity_participants")
}

// One row per assignee. Reassigning or cancelling one assignment never
// touches another assignment on the same activity — mirrors the
// Route/RouteAssignment split (the activity is the content; this is who's
// doing it), except here more than one row can be PLANNED for the same
// activity at once, by design. `scheduledDate` lives here, not on Activity:
// scheduling happens at assignment time, and different assignees of the
// same activity can be scheduled on different dates.
// Fields below the relations are this assignee's own *execution* data —
// what this one delegate actually did and achieved, independent of any
// other delegate assigned to the same Activity. Which fields apply is
// determined by the parent Activity's typeId.category/code at the Zod
// boundary (src/lib/schemas/activity.ts), not enforced in the database:
// every field here is nullable and simply left unset for types it doesn't
// apply to.
model ActivityAssignment {
  id            String                   @id @default(cuid())
  status        ActivityAssignmentStatus @default(PLANNED)
  scheduledDate DateTime

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  followUps      FollowUp[]
  results        AssignmentParticipantResult[]
  productResults AssignmentProductResult[]

  // Set by updateAssignmentExecution every time the delegate saves the
  // execution form — including a save where every field was left blank,
  // since the signal this exists for is "the delegate has visited
  // execution at least once," not "some field is non-null" (a type like
  // Necessity-Driven can legitimately have a sparse execution form). The
  // My Activities "Mark done" button reads this to warn/disable before a
  // delegate marks an assignment DONE with no recorded results — a trap
  // confirmed in practice: RTM's per-participant follow-up fan-out finds
  // nothing to do when nobody was ever marked present.
  executionRecordedAt DateTime?

  outcomeNotes        String? // general feedback, all standard-event types
  // CPN / CPS: client explicitly separates HCP feedback from the feedback
  // of the pregnant women / children reached — kept as two distinct fields
  // rather than one blended outcomeNotes.
  hcpFeedback         String?
  beneficiaryFeedback String?
  // Bonjour: "feedback and commitments" — a commitment is a specific
  // promise made, distinct in kind from general impression/feedback text.
  commitments         String?

  pregnantWomenReached Int? // CPN
  childrenConsulted    Int? // CPS
  // Expected counts (prescriberCount / expectedParticipants) live on Activity
  // now, set at creation — this is only ever the delegate's own actual count.
  actualParticipants   Int? // CME / Nurse Conference / Bonjour / Matinee Scientifique / La Garde

  nightShiftTiming String? // La Garde

  // requirementCategory lives on Activity now (set at creation) — these
  // three stay execution-time, filled in by the delegate when they fulfill
  // the need.
  requirementValue           Decimal? @db.Decimal(14, 2)
  supportProvidedDescription String? // what was actually given, distinct from the category
  recipientContactId         String?
  recipient                  Contact? @relation("ActivityAssignmentRecipient", fields: [recipientContactId], references: [id])

  // This delegate's own expense, if distinct from the shared Activity-level
  // cost (see Activity.foodExpense above) — e.g. La Garde is typically a
  // single delegate per night shift, so this is often the figure actually
  // used. Never summed with the Activity-level figure automatically; a
  // report must label which one it's showing.
  foodExpense      Decimal? @db.Decimal(12, 2)
  transportExpense Decimal? @db.Decimal(12, 2)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([activityId])
  @@index([userId])
  @@index([scheduledDate])
  @@index([recipientContactId])
  @@map("activity_assignments")
}

// This assignee's own record of a participant's actual presence/outcome —
// as opposed to ActivityParticipant above, which is the shared invited
// list. `unplanned` covers a doctor this delegate met who wasn't on the
// original invited list (allowed, flagged, not rejected). The other side of
// this relation is FollowUp.participantResultId — deliberately not
// @unique there, so a participant can hold several follow-ups over a chain.
model AssignmentParticipantResult {
  id           String             @id @default(cuid())
  assignmentId String
  assignment   ActivityAssignment @relation(fields: [assignmentId], references: [id])
  contactId    String
  contact      Contact            @relation("AssignmentParticipantResultContact", fields: [contactId], references: [id])

  present   Boolean @default(false)
  unplanned Boolean @default(false)

  feedback               String?
  prescriptionsGenerated Int?

  followUps FollowUp[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, contactId])
  @@map("assignment_participant_results")
}

// This assignee's own product-level results — kept separate from
// ActivityProduct.availability (a shared fact about the venue) because
// prescriptions/business/samples are results this delegate is personally
// accountable for, not a property of the meeting itself. `unplanned` covers
// a product this delegate discussed that wasn't on the Activity's planned
// product list.
model AssignmentProductResult {
  id           String             @id @default(cuid())
  assignmentId String
  assignment   ActivityAssignment @relation(fields: [assignmentId], references: [id])
  productId    String
  product      Product            @relation(fields: [productId], references: [id])

  unplanned Boolean @default(false)

  prescriptionsGenerated Int?
  businessValueGenerated Decimal? @db.Decimal(14, 2)
  samplesProvided        Int?
  // La Garde: whether this product was actually available on this specific
  // visit — distinct from ActivityProduct.availability (the shared,
  // planned fact set once at creation). La Garde is typically a different
  // delegate each night, so availability can genuinely differ visit to
  // visit; this is that per-assignment record, not a duplicate of the
  // shared one.
  availability           String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, productId])
  @@map("assignment_product_results")
}

// Linked to an assignment, not the bare activity: with several people
// possibly assigned to the same activity, each assignee's follow-ups stay
// theirs, never visible or completable by a different assignee on the same
// activity. Linked to Activity only for now — the doc's "linked to a visit
// or activity" would also cover Visit, but Visit (while it exists as a bare
// table since S1-03) has no working visit-execution feature yet; that's
// S4-01, Sprint 4. A visitId relation is deferred until that story actually
// builds visit execution, rather than forward-referencing a feature that
// doesn't exist yet.
model FollowUp {
  id      String         @id @default(cuid())
  dueDate DateTime
  status  FollowUpStatus @default(PENDING)

  assignmentId String
  assignment   ActivityAssignment @relation(fields: [assignmentId], references: [id])

  // Set = this follow-up is about one specific invited participant (RTM's
  // one-per-present-prescriber chain, optionally CME/Nurse); null = an
  // assignment-level chain with no single participant in mind. Deliberately
  // NOT @unique — a participant can hold several follow-ups across a chain
  // (e.g. a repeated CME series for the same doctor). Getting this wrong
  // was caught during design, see the §3.4 note in Marketing Activity.md.
  participantResultId String?
  participantResult   AssignmentParticipantResult? @relation(fields: [participantResultId], references: [id])

  // Decoupled from assignment.userId on purpose: reassigning a follow-up
  // must not require reassigning the whole assignment it was raised
  // against. Backfilled from assignment.userId for every pre-existing row.
  ownerId String
  owner   User   @relation("FollowUpOwner", fields: [ownerId], references: [id])

  // Filled on completion, not just a status flip — distinct from the
  // generic PENDING/DONE status, and from the type-specific numeric/boolean
  // fields below (which exist so reports can aggregate "business generated
  // via follow-ups" or filter "product unavailable", rather than hiding
  // that data inside free text).
  outcome                String?
  prescriptionsGenerated Int?
  businessValueGenerated Decimal? @db.Decimal(14, 2)
  productAvailable       Boolean?

  // Chain config, copied forward from ActivityTypeDef's
  // defaultFollowUp*Days fields onto each generated FollowUp (not re-read
  // from the type at every step) so a later change to the type's config
  // never silently reshapes an in-flight chain. Null = no further link
  // (RTM's chain, or any manually-created follow-up).
  seriesIntervalDays Int?
  seriesEndDate      DateTime?

  // One child per parent — the @unique on parentFollowUpId is what makes a
  // concurrent duplicate completion produce at most one child.
  parentFollowUpId String?   @unique
  parentFollowUp   FollowUp? @relation("FollowUpChain", fields: [parentFollowUpId], references: [id])
  childFollowUp    FollowUp? @relation("FollowUpChain")

  reassignments FollowUpReassignment[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([assignmentId])
  @@index([dueDate])
  @@index([participantResultId])
  @@index([ownerId])
  @@map("follow_ups")
}

// Audit trail for FollowUp.ownerId changes — reassignFollowUp updates the
// current row's ownerId in place (unlike assignment reassignment, which
// cancels and recreates a new row) and writes one of these in the same
// transaction, so ownership history stays visible even though the owning
// row itself doesn't carry its own past.
model FollowUpReassignment {
  id         String   @id @default(cuid())
  followUpId String
  followUp   FollowUp @relation(fields: [followUpId], references: [id])

  previousOwnerId String
  previousOwner   User   @relation("FollowUpReassignPrevOwner", fields: [previousOwnerId], references: [id])
  newOwnerId      String
  newOwner        User   @relation("FollowUpReassignNewOwner", fields: [newOwnerId], references: [id])

  reassignedBy     String
  reassignedByUser User     @relation("FollowUpReassignActor", fields: [reassignedBy], references: [id])
  reassignedAt     DateTime @default(now())

  @@index([followUpId])
  @@map("follow_up_reassignments")
}

// --- Contacts (doctors, nurses, other professionals) ---

// Configurable lookup, same shape as CenterType — never a TypeScript enum.
// `code` is derived from the name (uppercase, accent-free slug), so it also
// acts as the case-insensitive uniqueness guard when an admin types a new
// value into the create-or-select combobox.
model ContactType {
  id   String @id @default(cuid())
  code String @unique
  name String

  contacts Contact[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("contact_types")
}

// Professional specialization / department — separate from ContactType.
// Seeded from the client's source data (see prisma/seed.ts); admins can add
// more from the Contacts form. Also doubles as the role a Contact holds at
// one specific Center (ContactCenterRole was dropped as redundant with it).
model Specialization {
  id   String @id @default(cuid())
  code String @unique
  name String

  contactCenters ContactCenter[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("specializations")
}

// `code` is backend-generated (CON-00001, from the contact_code_seq
// Postgres sequence created in the migration) and immutable once written.
// `territoryId` is the Contact's own Territory — independent of any
// associated Center's.
model Contact {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  gender Gender?
  mobile String?
  status Status  @default(ACTIVE)

  contactTypeId String
  contactType   ContactType @relation(fields: [contactTypeId], references: [id])

  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id])

  centers    ContactCenter[]
  routeItems RouteItemContact[]

  activitiesAsSpeaker           Activity[]                    @relation("ActivitySpeaker")
  activityParticipations        ActivityParticipant[]         @relation("ActivityParticipantContact")
  necessityRecipientAssignments ActivityAssignment[]          @relation("ActivityAssignmentRecipient")
  assignmentParticipantResults  AssignmentParticipantResult[] @relation("AssignmentParticipantResultContact")

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([contactTypeId, status])
  @@index([territoryId, status])
  @@index([name])
  @@map("contacts")
}

// Many-to-many join between Contact and Center (the Center model), carrying
// the per-association specialization. specializationId lives here, not on
// Contact, because the same person can hold a different specialization at
// each Center (e.g. Généraliste at one hospital, Pédiatre at another).
model ContactCenter {
  id String @id @default(cuid())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  centerId String
  center   Center @relation(fields: [centerId], references: [id])

  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([contactId, centerId])
  @@index([centerId])
  @@index([specializationId])
  @@map("contact_centers")
}

// --- Emballage / Notice (Story C): a simple repeatable collection log, no
// assignment/status/follow-up machinery at all, unlike the standard-event
// activities above. Same centre can be logged multiple times across
// different visits — each collection is its own row, never merged.

// `quantity` always holds the *current* (corrected) value — every report
// and export reads this column directly, with no "use the corrected one"
// branching anywhere else. `correctionCount`/`locked` exist so the UI can
// show a "corrected" indicator and gate who may correct a given row without
// a join to EmballageCorrection/EmballageReportRun on every list render.
model EmballageCollection {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  visitDate DateTime
  quantity  Decimal  @db.Decimal(12, 2)
  remarks   String?

  // Incremented on every correction; purely a display signal (`>0` means
  // "has been corrected"), never read for authorization or totals.
  correctionCount Int @default(0)

  // Set true in bulk when an EmballageReportRun finalizes the calendar
  // month this row's visitDate falls in. Once true, correcting it needs
  // emballage:correct-locked instead of the normal emballage:record-own —
  // see EmballageReportRun.
  locked Boolean @default(false)

  corrections EmballageCorrection[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([centerId, productId])
  @@index([userId])
  @@index([visitDate])
  @@map("emballage_collections")
}

// Append-only audit trail for EmballageCollection.quantity corrections —
// the row itself is updated in place (no negative offset rows), and one of
// these is written alongside it in the same transaction so the original
// value, who corrected it and why stay visible as history. Same pattern as
// FollowUpReassignment.
model EmballageCorrection {
  id           String              @id @default(cuid())
  collectionId String
  collection   EmballageCollection @relation(fields: [collectionId], references: [id])

  previousQuantity Decimal @db.Decimal(12, 2)
  newQuantity      Decimal @db.Decimal(12, 2)
  reason           String?

  correctedBy     String
  correctedByUser User     @relation(fields: [correctedBy], references: [id])
  correctedAt     DateTime @default(now())

  @@index([collectionId])
  @@map("emballage_corrections")
}

// One row per calendar month a manager finalizes the EOM
// centre-wise/product-wise reconciliation report. Finalizing bulk-sets
// EmballageCollection.locked = true for every row with a visitDate in that
// month, in one transaction — after that, only emballage:correct-locked can
// still correct them, not the ordinary emballage:record-own grant every
// delegate holds.
model EmballageReportRun {
  id          String @id @default(cuid())
  periodMonth Int
  periodYear  Int

  finalizedBy     String
  finalizedByUser User     @relation(fields: [finalizedBy], references: [id])
  finalizedAt     DateTime @default(now())

  @@unique([periodMonth, periodYear])
  @@map("emballage_report_runs")
}
