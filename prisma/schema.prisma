generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  DRAFT
  SUBMITTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  INCOMPLETE
  ABSENT
  NON_WORKING
  NEEDS_REVIEW
}

// --- Identity ---

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

// Explicit join model (rather than an implicit many-to-many) so the grant
// itself carries an audit trail of who assigned which permission to which
// role and when.
model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String @id @default(cuid())
  employeeCode String @unique
  name         String
  email        String @unique
  passwordHash String
  status       Status @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  managerId     String?
  manager       User?   @relation("UserManager", fields: [managerId], references: [id])
  directReports User[]  @relation("UserManager")

  // Location assignment is independent per level — a Manager might be
  // scoped to a whole Province with nothing below it set, while a
  // Delegate is scoped down to one Quartier. Each is its own optional FK
  // rather than one leaf id, since the cascading select on the Users page
  // lets an admin stop at any level.
  provinceId String?
  province   Province? @relation(fields: [provinceId], references: [id])

  villeId String?
  ville   Ville?  @relation(fields: [villeId], references: [id])

  communeId String?
  commune   Commune? @relation(fields: [communeId], references: [id])

  quartierId String?
  quartier   Quartier? @relation(fields: [quartierId], references: [id])

  visits      Visit[]
  orders      Order[]
  attendances Attendance[]
  targets     Target[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("users")
}

// --- Territory: a fixed 4-level administrative hierarchy
// (Province > Ville > Commune > Quartier), matching how the client's own
// location data is structured — not a flat code+name table, and no `code`
// field, since the real data identifies each level by name only. ---

model Province {
  id     String @id @default(cuid())
  name   String @unique
  status Status @default(ACTIVE)

  villes  Ville[]
  users   User[]
  clients Client[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("provinces")
}

model Ville {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])

  communes Commune[]
  users    User[]
  clients  Client[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@map("villes")
}

model Commune {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  villeId String
  ville   Ville  @relation(fields: [villeId], references: [id])

  quartiers Quartier[]
  users     User[]
  clients   Client[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([villeId, name])
  @@map("communes")
}

model Quartier {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])

  users   User[]
  clients Client[]
  targets Target[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([communeId, name])
  @@map("quartiers")
}

// --- Master data ---

model ClientType {
  id   String @id @default(cuid())
  code String @unique
  name String

  clients Client[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("client_types")
}

model Client {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String?
  address   String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  status    Status   @default(ACTIVE)

  typeId String
  type   ClientType @relation(fields: [typeId], references: [id])

  // Location assignment is independent per level, same as User — a client
  // known only down to its Commune (say) can be recorded there without a
  // specific Quartier, rather than being forced to the most granular level.
  provinceId String?
  province   Province? @relation(fields: [provinceId], references: [id])

  villeId String?
  ville   Ville?  @relation(fields: [villeId], references: [id])

  communeId String?
  commune   Commune? @relation(fields: [communeId], references: [id])

  quartierId String?
  quartier   Quartier? @relation(fields: [quartierId], references: [id])

  visits Visit[]
  orders Order[]

  // At most one of these is ever set, matched to `type` — a Doctor client
  // has a `doctor` row and no `hospital` row, and vice versa. Kept as two
  // optional one-to-one extensions rather than fields on Client itself so a
  // Chemist/Pharmacy client (neither Doctor nor Hospital) carries no unused
  // columns, and so Doctor/Hospital can each grow their own fields later
  // without widening every other client type's row.
  doctor   Doctor?
  hospital Hospital?

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("clients")
}

// One-to-one extension of Client for the DOCTOR type. A Doctor can be
// associated with several Hospitals (see DoctorHospital) — that's a
// separate relation, not a field here, because the source data shows the
// same doctor visited at multiple hospitals; a single hospitalId would
// wrongly limit them to one.
model Doctor {
  id String @id @default(cuid())

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  doctorType String?
  gender     String?
  department String?
  mobileNo   String?

  hospitals DoctorHospital[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("doctors")
}

// One-to-one extension of Client for the HOSPITAL type.
model Hospital {
  id String @id @default(cuid())

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  hospitalCategory String?

  doctors DoctorHospital[]
  visits  Visit[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("hospitals")
}

// Explicit join model (not an implicit many-to-many), same reasoning as
// RolePermission: the link itself carries an audit trail of who associated
// which doctor with which hospital and when. A Doctor visited at several
// Hospitals gets one Doctor row and several of these, never several Doctor
// rows for the same person.
model DoctorHospital {
  id String @id @default(cuid())

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([doctorId, hospitalId])
  @@map("doctor_hospitals")
}

model Product {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  category String?
  price    Decimal @db.Decimal(12, 2)
  currency String  @default("AED")
  status   Status  @default(ACTIVE)

  orderItems OrderItem[]
  targets    Target[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("products")
}

// --- Visits ---

model Visit {
  id String @id @default(cuid())

  delegateId String
  delegate   User   @relation(fields: [delegateId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Which Hospital the visit happened at, when relevant — e.g. "visited
  // Doctor A at Hospital B" records clientId = Doctor A, hospitalId =
  // Hospital B. Optional: a visit straight to a Hospital or to a Chemist/
  // Pharmacy client has no separate hospital to record. When both are set
  // and the client is a Doctor, the service layer must confirm the pair
  // exists in DoctorHospital before saving.
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  startAt  DateTime
  endAt    DateTime?
  startLat Decimal   @db.Decimal(9, 6)
  startLng Decimal   @db.Decimal(9, 6)
  endLat   Decimal?  @db.Decimal(9, 6)
  endLng   Decimal?  @db.Decimal(9, 6)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("visits")
}

// --- Orders ---

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(DRAFT)

  delegateId String
  delegate   User   @relation(fields: [delegateId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  items OrderItem[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

// --- Attendance ---

model Attendance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  date   DateTime
  status AttendanceStatus @default(NEEDS_REVIEW)

  checkInAt  DateTime?
  checkInLat Decimal?  @db.Decimal(9, 6)
  checkInLng Decimal?  @db.Decimal(9, 6)

  checkOutAt  DateTime?
  checkOutLat Decimal?  @db.Decimal(9, 6)
  checkOutLng Decimal?  @db.Decimal(9, 6)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("attendances")
}

// --- Targets ---

model Target {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  quartierId String?
  quartier   Quartier? @relation(fields: [quartierId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  quantity    Decimal  @db.Decimal(12, 2)
  value       Decimal  @db.Decimal(14, 2)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("targets")
}
