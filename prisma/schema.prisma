generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  DRAFT
  SUBMITTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  INCOMPLETE
  ABSENT
  NON_WORKING
  NEEDS_REVIEW
}

// --- Identity ---

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

// Explicit join model (rather than an implicit many-to-many) so the grant
// itself carries an audit trail of who assigned which permission to which
// role and when.
model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String @id @default(cuid())
  employeeCode String @unique
  name         String
  email        String @unique
  passwordHash String
  status       Status @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  managerId     String?
  manager       User?   @relation("UserManager", fields: [managerId], references: [id])
  directReports User[]  @relation("UserManager")

  // Location assignment is independent per level — a Manager might be
  // scoped to a whole Province with nothing below it set, while a
  // Delegate is scoped down to one Quartier. Each is its own optional FK
  // rather than one leaf id, since the cascading select on the Users page
  // lets an admin stop at any level.
  provinceId String?
  province   Province? @relation(fields: [provinceId], references: [id])

  villeId String?
  ville   Ville?  @relation(fields: [villeId], references: [id])

  communeId String?
  commune   Commune? @relation(fields: [communeId], references: [id])

  quartierId String?
  quartier   Quartier? @relation(fields: [quartierId], references: [id])

  visits               Visit[]
  orders               Order[]
  attendances          Attendance[]
  targets              Target[]
  territoryAssignments UserTerritoryAssignment[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("users")
}

// --- Territory: a fixed 4-level administrative hierarchy
// (Province > Ville > Commune > Quartier), matching how the client's own
// location data is structured — not a flat code+name table, and no `code`
// field, since the real data identifies each level by name only. ---

model Province {
  id     String @id @default(cuid())
  name   String @unique
  status Status @default(ACTIVE)

  villes               Ville[]
  users                User[]
  clients              Client[]
  territoryAssignments UserTerritoryAssignment[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("provinces")
}

model Ville {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])

  communes             Commune[]
  users                User[]
  clients              Client[]
  territoryAssignments UserTerritoryAssignment[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([provinceId, name])
  @@map("villes")
}

model Commune {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  villeId String
  ville   Ville  @relation(fields: [villeId], references: [id])

  quartiers            Quartier[]
  users                User[]
  clients              Client[]
  territoryAssignments UserTerritoryAssignment[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([villeId, name])
  @@map("communes")
}

model Quartier {
  id     String @id @default(cuid())
  name   String
  status Status @default(ACTIVE)

  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])

  users                User[]
  clients              Client[]
  targets              Target[]
  territoryAssignments UserTerritoryAssignment[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([communeId, name])
  @@map("quartiers")
}

// One row per (user, single territory) assignment — the set of territories
// a delegate is allowed to work in (S2-04). Distinct from the four
// home-territory fields on User above: those stay as a default/display
// value, but any future work-scoping logic (e.g. restricting which clients
// a delegate can select) must read from this table instead.
//
// Unlike User/Client's own four fields (which populate every ancestor level
// together as the cascading select narrows down), each row here stores
// only the single specific level actually being assigned — exactly one of
// the four FKs is set, the rest stay null. This is deliberate: populating
// ancestor levels too would make the per-level unique constraints below
// misfire (e.g. two different Ville-level assignments under the same
// Province would falsely collide on `provinceId` if it were also stored on
// both rows).
//
// Four separate two-column unique constraints, not one across all four —
// each blocks an exact duplicate at whichever level is actually populated
// (Postgres never treats two NULLs as equal, so a constraint on a column
// that's null for a given row simply doesn't apply to it). This still
// allows a Province and a Quartier already inside it to both be assigned to
// the same user — harmless overlap, deliberately not blocked (see the
// project decision log for S2-04).
model UserTerritoryAssignment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  provinceId String?
  province   Province? @relation(fields: [provinceId], references: [id])

  villeId String?
  ville   Ville?  @relation(fields: [villeId], references: [id])

  communeId String?
  commune   Commune? @relation(fields: [communeId], references: [id])

  quartierId String?
  quartier   Quartier? @relation(fields: [quartierId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([userId, provinceId])
  @@unique([userId, villeId])
  @@unique([userId, communeId])
  @@unique([userId, quartierId])
  @@map("user_territory_assignments")
}

// --- Master data ---

model ClientType {
  id   String @id @default(cuid())
  code String @unique
  name String

  clients Client[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("client_types")
}

model Client {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String?
  address   String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  status    Status   @default(ACTIVE)

  typeId String
  type   ClientType @relation(fields: [typeId], references: [id])

  // Location assignment is independent per level, same as User — a client
  // known only down to its Commune (say) can be recorded there without a
  // specific Quartier, rather than being forced to the most granular level.
  provinceId String?
  province   Province? @relation(fields: [provinceId], references: [id])

  villeId String?
  ville   Ville?  @relation(fields: [villeId], references: [id])

  communeId String?
  commune   Commune? @relation(fields: [communeId], references: [id])

  quartierId String?
  quartier   Quartier? @relation(fields: [quartierId], references: [id])

  visits Visit[]
  orders Order[]

  // At most one of these is ever set, matched to `type` — a Doctor client
  // has a `doctor` row and no `hospital` row, and vice versa. Kept as two
  // optional one-to-one extensions rather than fields on Client itself so a
  // Chemist/Pharmacy client (neither Doctor nor Hospital) carries no unused
  // columns, and so Doctor/Hospital can each grow their own fields later
  // without widening every other client type's row.
  doctor   Doctor?
  hospital Hospital?

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("clients")
}

// One-to-one extension of Client for the DOCTOR type. A Doctor can be
// associated with several Hospitals (see DoctorHospital) — that's a
// separate relation, not a field here, because the source data shows the
// same doctor visited at multiple hospitals; a single hospitalId would
// wrongly limit them to one.
model Doctor {
  id String @id @default(cuid())

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  doctorType String?
  gender     String?
  department String?
  mobileNo   String?

  hospitals DoctorHospital[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("doctors")
}

// One-to-one extension of Client for the HOSPITAL type.
model Hospital {
  id String @id @default(cuid())

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  hospitalCategory String?

  doctors DoctorHospital[]
  visits  Visit[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("hospitals")
}

// Explicit join model (not an implicit many-to-many), same reasoning as
// RolePermission: the link itself carries an audit trail of who associated
// which doctor with which hospital and when. A Doctor visited at several
// Hospitals gets one Doctor row and several of these, never several Doctor
// rows for the same person.
model DoctorHospital {
  id String @id @default(cuid())

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([doctorId, hospitalId])
  @@map("doctor_hospitals")
}

// Lookup table, same pattern as ClientType — the price list has no
// classification column at all, so this stays a short seeded list (or
// left unset on a Product) rather than a fixed enum, until the client
// confirms an actual taxonomy.
model ProductCategory {
  id   String @id @default(cuid())
  code String @unique
  name String

  products Product[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("product_categories")
}

// Base currency is always USD (D3: confirmed with the client — see
// ExchangeRate below for the CDF conversion, which is display-only and
// never stored here). The source price list carries two prices per
// product — grossPrice and a netPrice already discounted — and both are
// stored as-is rather than netPrice being derived from a percentage,
// since the discount isn't confirmed to be a fixed, permanent rule.
model Product {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  grossPrice Decimal @db.Decimal(12, 2)
  netPrice   Decimal @db.Decimal(12, 2)
  status     Status  @default(ACTIVE)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  orderItems   OrderItem[]
  targets      Target[]
  priceHistory ProductPriceHistory[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("products")
}

// One row per price change (S2-03: "a later price change cannot alter a
// submitted order") — appended on every create and on every update that
// changes either price, never edited or deleted, so a past price can
// always be reconstructed independently of what the Product row now says.
model ProductPriceHistory {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  grossPrice Decimal @db.Decimal(12, 2)
  netPrice   Decimal @db.Decimal(12, 2)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("product_price_history")
}

// USD → CDF conversion rate, set manually by an admin (the client's rate
// always runs a bit above the central bank's, and is only ever updated by
// hand — see the D3 discussion). Append-only: changing the rate inserts a
// new row rather than overwriting the last one, so a value already
// snapshotted elsewhere (e.g. onto an Order, in a later sprint) is never
// affected by a later change, and "the rate on a given date" stays
// reconstructable. "Current" is always the row with the latest
// effectiveFrom.
model ExchangeRate {
  id            String   @id @default(cuid())
  rate          Decimal  @db.Decimal(12, 4)
  effectiveFrom DateTime @default(now())

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("exchange_rates")
}

// --- Visits ---

model Visit {
  id String @id @default(cuid())

  delegateId String
  delegate   User   @relation(fields: [delegateId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Which Hospital the visit happened at, when relevant — e.g. "visited
  // Doctor A at Hospital B" records clientId = Doctor A, hospitalId =
  // Hospital B. Optional: a visit straight to a Hospital or to a Chemist/
  // Pharmacy client has no separate hospital to record. When both are set
  // and the client is a Doctor, the service layer must confirm the pair
  // exists in DoctorHospital before saving.
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  startAt  DateTime
  endAt    DateTime?
  startLat Decimal   @db.Decimal(9, 6)
  startLng Decimal   @db.Decimal(9, 6)
  endLat   Decimal?  @db.Decimal(9, 6)
  endLng   Decimal?  @db.Decimal(9, 6)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("visits")
}

// --- Orders ---

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(DRAFT)

  delegateId String
  delegate   User   @relation(fields: [delegateId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  items OrderItem[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

// --- Attendance ---

model Attendance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  date   DateTime
  status AttendanceStatus @default(NEEDS_REVIEW)

  checkInAt  DateTime?
  checkInLat Decimal?  @db.Decimal(9, 6)
  checkInLng Decimal?  @db.Decimal(9, 6)

  checkOutAt  DateTime?
  checkOutLat Decimal?  @db.Decimal(9, 6)
  checkOutLng Decimal?  @db.Decimal(9, 6)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("attendances")
}

// --- Targets ---

model Target {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  quartierId String?
  quartier   Quartier? @relation(fields: [quartierId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  quantity    Decimal  @db.Decimal(12, 2)
  value       Decimal  @db.Decimal(14, 2)

  createdBy String?
  createdAt DateTime @default(now())
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("targets")
}
