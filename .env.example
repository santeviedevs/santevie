# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# --- Postgres (docker-compose) ---
DATABASE_URL=postgresql://santevie:santevie@localhost:5432/santevie

# --- Storage (S3 API) ---
# Local dev talks to the MinIO container started by docker-compose.
# In staging/prod, swap these for real Cloudflare R2 values and leave the
# rest of the app unchanged (R2 speaks the same S3 API).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=santevie-local
S3_ACCESS_KEY_ID=santevie
S3_SECRET_ACCESS_KEY=santevie123
S3_FORCE_PATH_STYLE=true

# --- Cloudflare R2 (staging/prod reference) ---
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=<your-r2-bucket-name>
# S3_ACCESS_KEY_ID=<r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# S3_FORCE_PATH_STYLE=false
