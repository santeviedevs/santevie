# Copy this file to .env.local for local development:
#   cp .env.example .env.local

# --- Auth.js ---
# Signs and encrypts session JWTs. Generate one with `npx auth secret`
# (writes it into .env.local automatically) — never commit a real value.
AUTH_SECRET=0fO5KqxQtL/Xr+0nK2Datt9lI42M9jasAZfrE8vBy14=

# --- Postgres (docker-compose) ---
DATABASE_URL=postgresql://santevie:santevie@localhost:5432/santevie

# --- Postgres (Supabase, dev/UAT/prod reference) ---
# Local dev uses the docker-compose Postgres above. Dev/UAT/prod environments
# point at Supabase projects instead. DATABASE_URL is the pooled connection via
# Supavisor (used by the app at runtime, port 6543); DIRECT_URL is the direct
# connection (required by `prisma migrate`, port 5432).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Storage (S3 API) ---
# Local dev talks to the MinIO container started by docker-compose.
# In staging/prod, swap these for real Supabase Storage values and leave the
# rest of the app unchanged (Supabase Storage speaks the S3 API).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=santevie-local
S3_ACCESS_KEY_ID=santevie
S3_SECRET_ACCESS_KEY=santevie123
S3_FORCE_PATH_STYLE=true

# --- Supabase Storage (dev/UAT/prod reference) ---
# From Project Settings > Storage > S3 Connection. Region shown there is a
# fixed value tied to the project, not necessarily its Postgres region.
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<region-shown-in-s3-connection-panel>
# S3_BUCKET=<your-bucket-name>
# S3_ACCESS_KEY_ID=<supabase-s3-access-key-id>
# S3_SECRET_ACCESS_KEY=<supabase-s3-secret-access-key>
# S3_FORCE_PATH_STYLE=true
